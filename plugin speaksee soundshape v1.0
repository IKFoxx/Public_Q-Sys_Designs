Advanced Integration

You could also:

Route Speaksee subtitle URLs directly to Q-SYS Touch Panels.
Trigger translations when meetings start.
Display Speaksee status on a UCI.
Control SoundShape subtitle sessions from room presets.
Synchronize microphone status with Q-SYS monitoring dashboards.

Plugin Structure
SpeakSeeQSYS/
├── plugin.lua
├── controls.lua
├── network.lua
├── ui.lua
└── README.md
]]--

--plugin.lua
PluginInfo = {
    Name = "SpeakSee Controller",
    Version = "1.0.0",
    Id = "com.soundshape.speaksee",
    Author = "Custom Integration"
}

Properties = {
    {
        Name = "Host",
        Type = "String",
        Value = "192.168.1.100"
    },
    {
        Name = "Port",
        Type = "Integer",
        Value = 80
    },
    {
        Name = "Username",
        Type = "String",
        Value = ""
    },
    {
        Name = "Password",
        Type = "String",
        Value = ""
    },
    {
        Name = "Polling Interval",
        Type = "Integer",
        Value = 10
    }
}

--Controls Definition
Controls = {

    {
        Name = "Connect",
        ControlType = "Button",
        Count = 1
    },

    {
        Name = "Disconnect",
        ControlType = "Button",
        Count = 1
    },

    {
        Name = "Status",
        ControlType = "Indicator",
        Count = 1
    },

    {
        Name = "StartSession",
        ControlType = "Button",
        Count = 1
    },

    {
        Name = "StopSession",
        ControlType = "Button",
        Count = 1
    },

    {
        Name = "EnableTranslation",
        ControlType = "Button",
        Count = 1
    },

    {
        Name = "Language",
        ControlType = "Text",
        Count = 1
    },

    {
        Name = "ActiveSpeakers",
        ControlType = "Text",
        Count = 1
    },

    {
        Name = "Mic1Battery",
        ControlType = "Knob",
        Count = 1
    },

    {
        Name = "Mic2Battery",
        ControlType = "Knob",
        Count = 1
    },

    {
        Name = "Mic3Battery",
        ControlType = "Knob",
        Count = 1
    },

    {
        Name = "LastError",
        ControlType = "Text",
        Count = 1
    }
}

Network Layer
local host = Properties["Host"].Value
local port = Properties["Port"].Value

function GetStatus()

    HttpClient.Get {
        Url = "http://" .. host .. ":" .. port .. "/api/status",

        EventHandler = function(tbl, code, data)

            if code == 200 then

                Controls.Status.Boolean = true

                local json = RapidJSON.Decode(data)

                Controls.ActiveSpeakers.String =
                    tostring(json.activeSpeakers)

                Controls.Mic1Battery.Value =
                    json.microphones[1].battery

                Controls.Mic2Battery.Value =
                    json.microphones[2].battery

                Controls.Mic3Battery.Value =
                    json.microphones[3].battery

            else

                Controls.Status.Boolean = false
                Controls.LastError.String =
                    "HTTP Error: " .. tostring(code)

            end
        end
    }
end

Session Control
function StartSession()

    HttpClient.Post {

        Url = "http://" ..
              Properties["Host"].Value ..
              "/api/session/start",

        EventHandler = function(tbl, code, data)

            if code == 200 then

                Log.Info("Session started")

            else

                Log.Error("Start failed")

            end
        end
    }

end

function StopSession()

    HttpClient.Post {

        Url = "http://" ..
              Properties["Host"].Value ..
              "/api/session/stop"

    }

end

Event Handlers
Controls.Connect.EventHandler = function()

    GetStatus()

end

Controls.StartSession.EventHandler = function()

    StartSession()

end

Controls.StopSession.EventHandler = function()

    StopSession()

end

Polling Timer
PollTimer = Timer.New()

PollTimer.EventHandler = function()

    GetStatus()

end

PollTimer:Start(
    Properties["Polling Interval"].Value
)

